<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!-- fx:ids must match the @FXML fields in MainController exactly. -->
<!-- Navigation is the compact sidebar; the tab bar itself is hidden (see .main-tab-pane in style.css). -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.financetracker.controller.MainController">
  <left>
    <VBox styleClass="sidebar" prefWidth="200" spacing="8">
      <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 0 0 16 8;">
        <StackPane>
          <Circle radius="18" fill="#3B82F6"/>
          <Label text="₹" styleClass="sidebar-logo-text"/>
        </StackPane>
        <VBox spacing="0">
          <Label text="Finance" styleClass="sidebar-title"/>
          <Label text="Tracker" styleClass="sidebar-title-accent"/>
        </VBox>
      </HBox>
      <Button fx:id="navOverviewButton" text="Overview" styleClass="nav-button" maxWidth="Infinity"/>
      <Button fx:id="navTransactionsButton" text="Transactions" styleClass="nav-button" maxWidth="Infinity"/>
      <Button fx:id="navBudgetsButton" text="Budgets" styleClass="nav-button" maxWidth="Infinity"/>
      <Button fx:id="navReportsButton" text="Reports" styleClass="nav-button" maxWidth="Infinity"/>
      <Button fx:id="navGoalsButton" text="Savings Goals" styleClass="nav-button" maxWidth="Infinity"/>
      <Button fx:id="navLoansButton" text="Loans" styleClass="nav-button" maxWidth="Infinity"/>
    </VBox>
  </left>
  <center>
    <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="main-tab-pane">

  <!-- ================= DASHBOARD ================= -->
  <Tab text="Dashboard">
    <ScrollPane fitToWidth="true">
      <VBox spacing="16" style="-fx-padding: 16;">
        <!-- Header: greeting and key actions. The title and metrics are the focus. -->
        <HBox spacing="16" alignment="CENTER_LEFT">
          <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label fx:id="greetingLabel" styleClass="greeting-title"/>
            <Label fx:id="overviewSubtitleLabel" styleClass="subtitle-text"/>
          </VBox>
          <Label text="Month:"/>
          <ComboBox fx:id="dashboardMonthBox" prefWidth="140"/>
          <Button fx:id="dashboardAddButton" text="+ Add transaction" styleClass="primary-button"/>
        </HBox>
        <!-- Key metrics: net cash flow is monthly income minus expenses, not an account balance.
             Each card has a small color-coded icon; values stay left-aligned at one size. -->
        <HBox spacing="16">
          <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
              <Label fx:id="netIconLabel" styleClass="stat-icon stat-icon-net"/>
              <Label text="Net cash flow" styleClass="stat-label"/>
            </HBox>
            <Label fx:id="balanceLabel" text="0.00" styleClass="stat-value net-value"/>
            <Label fx:id="balanceDeltaLabel" styleClass="delta-text"/>
          </VBox>
          <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
              <Label fx:id="incomeIconLabel" styleClass="stat-icon stat-icon-income"/>
              <Label text="Total income" styleClass="stat-label"/>
            </HBox>
            <Label fx:id="incomeLabel" text="0.00" styleClass="stat-value income-value"/>
            <Label fx:id="incomeDeltaLabel" styleClass="delta-text"/>
          </VBox>
          <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
              <Label fx:id="expenseIconLabel" styleClass="stat-icon stat-icon-expense"/>
              <Label text="Total expenses" styleClass="stat-label"/>
            </HBox>
            <Label fx:id="expenseLabel" text="0.00" styleClass="stat-value expense-value"/>
            <Label fx:id="expenseDeltaLabel" styleClass="delta-text"/>
          </VBox>
          <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
            <HBox spacing="8" alignment="CENTER_LEFT">
              <Label fx:id="savingsIconLabel" styleClass="stat-icon stat-icon-savings"/>
              <Label text="Savings rate" styleClass="stat-label"/>
            </HBox>
            <Label fx:id="savingsRateLabel" text="—" styleClass="stat-value savings-value"/>
            <Label fx:id="savingsCaptionLabel" text="share of income saved" styleClass="delta-text delta-neutral"/>
          </VBox>
        </HBox>
        <!-- Standing clarification: these are the selected month's figures, not a bank balance. -->
        <Label text="Figures cover the selected month only — not your total bank balance." styleClass="hint-text"/>
        <!-- Quick actions: the other two one-click jumps (Add lives in the header). -->
        <HBox spacing="8" alignment="CENTER_LEFT">
          <Label text="Quick actions" styleClass="section-title"/>
          <Button fx:id="quickBudgetButton" text="Set budget"/>
          <Button fx:id="quickExportButton" text="Export report"/>
        </HBox>
        <!-- Compact status panel: one icon, one short message, one direct action. -->
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="card">
          <Label fx:id="alertIconLabel" styleClass="alert-icon"/>
          <Label fx:id="alertLabel" wrapText="true" styleClass="alert-text" HBox.hgrow="ALWAYS"/>
          <Button fx:id="alertActionButton" styleClass="link-button" visible="false"/>
        </HBox>
        <HBox spacing="16">
          <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="Cash flow" styleClass="section-title" HBox.hgrow="ALWAYS"/>
              <ComboBox fx:id="cashflowRangeBox" prefWidth="150"/>
            </HBox>
            <Label fx:id="cashflowSubtitleLabel" text="Income vs expenses · Last 6 months" styleClass="subtitle-text"/>
            <BarChart fx:id="comparisonChart" prefHeight="230" styleClass="comparison-chart">
              <xAxis><CategoryAxis fx:id="comparisonXAxis"/></xAxis>
              <yAxis><NumberAxis fx:id="comparisonYAxis"/></yAxis>
            </BarChart>
            <Label fx:id="cashflowNoteLabel" wrapText="true" styleClass="hint-text" visible="false"/>
          </VBox>
          <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
            <Label text="Spending by category" styleClass="section-title"/>
            <Label text="This month" styleClass="subtitle-text"/>
            <StackPane fx:id="donutPane">
              <PieChart fx:id="dashboardChart" prefHeight="230"/>
              <Circle fx:id="donutHole" styleClass="donut-hole"/>
              <VBox alignment="CENTER" spacing="0">
                <Label fx:id="donutTotalValueLabel" styleClass="donut-total-value"/>
                <Label text="Total spent" styleClass="donut-total-caption"/>
              </VBox>
            </StackPane>
            <VBox fx:id="spendingLegendBox" spacing="4"/>
            <Label fx:id="spendingEmptyLabel" wrapText="true" styleClass="hint-text" visible="false"/>
          </VBox>
        </HBox>
        <HBox spacing="16">
          <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
            <Label text="Budget overview" styleClass="section-title"/>
            <Label text="This month" styleClass="subtitle-text"/>
            <VBox fx:id="budgetOverviewBox" spacing="8"/>
            <Label fx:id="budgetEmptyLabel" wrapText="true" styleClass="hint-text" visible="false"/>
          </VBox>
          <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8">
              <Label text="Recent transactions" styleClass="section-title" HBox.hgrow="ALWAYS"/>
              <Button fx:id="viewAllButton" text="View all" styleClass="link-button"/>
            </HBox>
            <TableView fx:id="recentTable" prefHeight="320">
              <columns>
                <TableColumn fx:id="recentDateCol" text="Date" prefWidth="100"/>
                <TableColumn fx:id="recentNoteCol" text="Description" prefWidth="180"/>
                <TableColumn fx:id="recentCategoryCol" text="Category" prefWidth="130"/>
                <TableColumn fx:id="recentAmountCol" text="Amount" prefWidth="110" styleClass="amount-col"/>
              </columns>
            </TableView>
          </VBox>
        </HBox>
        <Label fx:id="comparisonNoteLabel" text="Comparisons are month-to-date vs last month's full total."
               styleClass="hint-text" visible="false"/>
      </VBox>
    </ScrollPane>
  </Tab>

  <!-- ================= TRANSACTIONS ================= -->
  <Tab text="Transactions">
    <VBox spacing="16" style="-fx-padding: 16;">
      <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="typeBox" prefWidth="130"/>
        <ComboBox fx:id="categoryBox" prefWidth="200"/>
        <TextField fx:id="amountField" promptText="Amount" prefWidth="130"/>
        <DatePicker fx:id="datePicker" prefWidth="150"/>
      </HBox>
      <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="noteField" promptText="Note (optional)" prefWidth="280"/>
        <ComboBox fx:id="paymentBox" prefWidth="140"/>
        <Button fx:id="addButton" text="Add"/>
        <Button fx:id="cancelEditButton" text="Cancel edit" visible="false"/>
      </HBox>
      <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="filterTypeBox" prefWidth="110"/>
        <ComboBox fx:id="filterCategoryBox" prefWidth="150"/>
        <ComboBox fx:id="filterMonthBox" prefWidth="110"/>
        <Button fx:id="applyFilterButton" text="Filter"/>
      </HBox>
      <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search notes or categories..." prefWidth="280"/>
        <Button fx:id="searchButton" text="Search"/>
        <Button fx:id="showAllButton" text="Show all"/>
        <Button fx:id="editButton" text="Edit selected"/>
        <Button fx:id="deleteButton" text="Delete selected"/>
        <Button fx:id="importButton" text="Import CSV"/>
      </HBox>
      <TableView fx:id="txnTable" prefHeight="320">
        <columns>
          <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
          <TableColumn fx:id="dateCol" text="Date" prefWidth="110"/>
          <TableColumn fx:id="typeCol" text="Type" prefWidth="90"/>
          <TableColumn fx:id="categoryCol" text="Category" prefWidth="140"/>
          <TableColumn fx:id="amountCol" text="Amount" prefWidth="110" styleClass="amount-col"/>
          <TableColumn fx:id="paymentCol" text="Payment" prefWidth="110" styleClass="payment-col"/>
          <TableColumn fx:id="noteCol" text="Note" prefWidth="240"/>
        </columns>
      </TableView>
    </VBox>
  </Tab>

  <!-- ================= BUDGETS ================= -->
  <Tab text="Budgets">
    <VBox spacing="16" style="-fx-padding: 16;">
      <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="budgetCategoryBox" prefWidth="160"/>
        <TextField fx:id="budgetMonthField" promptText="YYYY-MM" prefWidth="100"/>
        <TextField fx:id="budgetAmountField" promptText="Monthly limit" prefWidth="130"/>
        <Button fx:id="setBudgetButton" text="Set budget"/>
        <Button fx:id="loadBudgetsButton" text="Refresh"/>
        <Button fx:id="copyBudgetsButton" text="Copy to next month"/>
        <Button fx:id="deleteBudgetButton" text="Delete selected budget"/>
      </HBox>
      <Label text="Status turns WARNING at 80% of the limit and OVER BUDGET at 100%. Budgets never carry forward on their own — use 'Copy to next month' when you want them to."
             wrapText="true" styleClass="hint-text"/>
      <TableView fx:id="budgetTable" prefHeight="320">
        <columns>
          <TableColumn fx:id="budgetCategoryCol" text="Category" prefWidth="160"/>
          <TableColumn fx:id="limitCol" text="Limit" prefWidth="110"/>
          <TableColumn fx:id="spentCol" text="Spent" prefWidth="110"/>
          <TableColumn fx:id="remainingCol" text="Remaining" prefWidth="110"/>
          <TableColumn fx:id="statusCol" text="Status" prefWidth="130"/>
        </columns>
      </TableView>
    </VBox>
  </Tab>

  <!-- ================= REPORTS ================= -->
  <Tab text="Reports">
    <VBox spacing="16" style="-fx-padding: 16;">
      <HBox spacing="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="periodBox" prefWidth="110"/>
        <ComboBox fx:id="reportMonthBox" prefWidth="110"/>
        <ComboBox fx:id="reportYearBox" prefWidth="90"/>
        <Button fx:id="loadReportButton" text="Load report"/>
        <Button fx:id="exportButton" text="Export all to CSV"/>
      </HBox>
      <Label fx:id="reportPeriodLabel" styleClass="section-title"/>
      <Label fx:id="reportTopLabel" wrapText="true"/>
      <Label fx:id="reportTotalLabel" text="Total expenses: 0.00" styleClass="section-title"/>
      <PieChart fx:id="expenseChart" prefHeight="260"/>
      <TableView fx:id="reportTable" prefHeight="180">
        <columns>
          <TableColumn fx:id="reportCategoryCol" text="Category" prefWidth="200"/>
          <TableColumn fx:id="reportTotalCol" text="Total spent" prefWidth="150"/>
        </columns>
      </TableView>
    </VBox>
  </Tab>

  <!-- ================= SAVINGS GOALS ================= -->
  <Tab text="Savings Goals">
    <VBox spacing="16" style="-fx-padding: 16;">
      <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="goalNameField" promptText="Goal name (e.g. Laptop)" prefWidth="200"/>
        <TextField fx:id="goalTargetField" promptText="Target amount" prefWidth="130"/>
        <DatePicker fx:id="goalDeadlinePicker" prefWidth="140"/>
        <Button fx:id="addGoalButton" text="Add goal"/>
      </HBox>
      <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="contributionAmountField" promptText="Contribution amount" prefWidth="160"/>
        <Button fx:id="contributeButton" text="Add contribution to selected goal"/>
        <Button fx:id="deleteGoalButton" text="Delete selected goal"/>
        <Button fx:id="editGoalButton" text="Edit selected goal"/>
        <Button fx:id="cancelGoalEditButton" text="Cancel edit" visible="false"/>
      </HBox>
      <Label text="Monthly needed = remaining amount ÷ months left until the deadline."
             styleClass="hint-text"/>
      <TableView fx:id="goalTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="goalNameCol" text="Goal" prefWidth="160"/>
          <TableColumn fx:id="goalTargetCol" text="Target" prefWidth="110"/>
          <TableColumn fx:id="goalSavedCol" text="Saved" prefWidth="110"/>
          <TableColumn fx:id="goalRemainingCol" text="Remaining" prefWidth="110"/>
          <TableColumn fx:id="goalProgressCol" text="Progress" prefWidth="130"/>
          <TableColumn fx:id="goalMonthlyCol" text="Monthly needed" prefWidth="130"/>
          <TableColumn fx:id="goalDeadlineCol" text="Deadline" prefWidth="110"/>
        </columns>
      </TableView>
    </VBox>
  </Tab>

  <!-- ================= LOANS ================= -->
  <Tab text="Loans">
    <VBox spacing="16" style="-fx-padding: 16;">
      <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="loanPersonField" promptText="Friend's name" prefWidth="160"/>
        <TextField fx:id="loanAmountField" promptText="Amount lent" prefWidth="120"/>
        <DatePicker fx:id="loanDatePicker" prefWidth="140"/>
        <TextField fx:id="loanNoteField" promptText="Note (optional)" prefWidth="180"/>
        <Button fx:id="addLoanButton" text="Add loan"/>
      </HBox>
      <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="repaymentAmountField" promptText="Repayment amount" prefWidth="160"/>
        <Button fx:id="recordRepaymentButton" text="Record repayment"/>
        <Button fx:id="deleteLoanButton" text="Delete selected loan"/>
      </HBox>
      <Label fx:id="loanSummaryLabel" styleClass="section-title"/>
      <TableView fx:id="loanTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="loanPersonCol" text="Person" prefWidth="160"/>
          <TableColumn fx:id="loanAmountCol" text="Lent" prefWidth="110"/>
          <TableColumn fx:id="loanReturnedCol" text="Returned" prefWidth="110"/>
          <TableColumn fx:id="loanRemainingCol" text="Still owed" prefWidth="110"/>
          <TableColumn fx:id="loanDateCol" text="Date" prefWidth="110"/>
          <TableColumn fx:id="loanStatusCol" text="Status" prefWidth="100"/>
        </columns>
      </TableView>
    </VBox>
  </Tab>
    </TabPane>
  </center>
</BorderPane>
